<?xml version="1.0" encoding="utf-8"?>
<!--
  ===========================================================================
   JAN-DRISHTI AI - Microsoft IIS edge tier (site-level web.config)
  ===========================================================================
   Layout for departments running the platform on Windows Server:

      officer browser
            | HTTPS
            v
      [ IIS + ARR ] -- URL Rewrite reverse proxy to an ARR server farm
            | http/1.1
            +--> app replica 1  http://127.0.0.1:8001
            +--> app replica 2  http://127.0.0.1:8002
            +--> app replica 3  http://127.0.0.1:8003
            +--> app replica 4  http://127.0.0.1:8004

   Prerequisites (once, as Administrator):
     1. Install IIS, then "Application Request Routing" (ARR) 3.0 and
        "URL Rewrite" 2.1  (Web Platform Installer / winget).
     2. Enable the proxy:  IIS Manager -> server node -> Application Request
        Routing Cache -> Server Proxy Settings -> Enable proxy + "Preserve host
        header" (or run the PowerShell below).
     3. Define the server farm (see deploy/iis/server-farm.md) or use the
        shared configuration snippet in that file - the farm itself lives in
        applicationHost.config, this web.config handles the site behaviour.

     Import-Module WebAdministration
     Set-WebConfigurationProperty -PSPath 'MACHINE/WEBROOT/APPHOST' `
       -Filter "system.webServer/proxy" -Name "enabled" -Value "True"
     Set-WebConfigurationProperty -PSPath 'MACHINE/WEBROOT/APPHOST' `
       -Filter "system.webServer/proxy" -Name "preserveHostHeader" -Value "True"

   Replica processes (same Python app, different ports):
     python -m jan_drishti.server --port 8001 &   (repeat 8002..8004)
   Every replica needs the same signing key so no sticky sessions are needed:
     setx JAN_DRISHTI_SECRET_KEY "<32+ random bytes>" /M
-->
<configuration>
  <system.webServer>

    <!-- ================= Layer 2: load balancing to the farm ================ -->
    <rewrite>
      <globalRules>
        <!-- Force HTTPS at the edge; the app itself only ever speaks HTTP. -->
        <rule name="RedirectToHttps" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="^OFF$" />
            <add input="{HTTP_HOST}" pattern="^localhost(:\d+)?$" negate="true" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>
      </globalRules>
      <rules>
        <!-- Health probe stays un-cached and un-authenticated for the farm monitor. -->
        <rule name="HealthProbe" stopProcessing="true">
          <match url="^health$" />
          <action type="Rewrite" url="http://jan_drishti_farm/health" />
        </rule>

        <!-- Static assets: let ARR's disk cache serve them. -->
        <rule name="StaticAssets" stopProcessing="true">
          <match url="^(.+\.(css|js|svg|png|ico|woff2))$" />
          <action type="Rewrite" url="http://jan_drishti_farm/{R:1}" />
          <serverVariables>
            <set name="HTTP_X_FARM_TIER" value="static" />
          </serverVariables>
        </rule>

        <!-- Everything else: reverse proxy to the ARR server farm. -->
        <rule name="ReverseProxyToFarm" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://jan_drishti_farm/{R:1}" />
          <serverVariables>
            <!-- The app trusts X-Forwarded-For so per-IP rate limits and the
                 audit trail record the officer, not the IIS box. -->
            <set name="HTTP_X_FORWARDED_FOR" value="{REMOTE_ADDR}" />
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
          </serverVariables>
        </rule>
      </rules>

      <outboundRules>
        <!-- Expose which replica served the request (same header the other
             proxies set), so the dashboard can prove the spread. -->
        <rule name="AddServedBy" preCondition="IsSuccess">
          <match serverVariable="RESPONSE_X_Served_By" pattern=".*" />
          <action type="Rewrite" value="{HTTP_X_SERVED_BY}" />
        </rule>
        <preConditions>
          <preCondition name="IsSuccess">
            <add input="{RESPONSE_STATUS}" pattern="^2" />
          </preCondition>
        </preConditions>
      </outboundRules>
    </rewrite>

    <!-- ================= Layer 1: edge traffic control ====================== -->
    <!-- Dynamic IP restrictions = IIS' built-in per-IP rate limiter (429/403).
         denyByRequest limits requests per interval; denyByConcurrent limits
         simultaneous connections. Mirrors the app's token bucket so the model
         engine is protected even if the app limit is raised. -->
    <security>
      <dynamicIpSecurity denyAction="Forbidden" denyByRequest="true"
                         maxRequests="25" requestInterval="00:00:01"
                         denyByConcurrent="true" maxConcurrentRequests="40" />
      <requestFiltering>
        <requestLimits maxAllowedContentLength="52428800" /> <!-- 50 MB uploads -->
        <fileExtensions allowUnlisted="true">
          <add fileExtension=".db" allowed="false" />
          <add fileExtension=".py" allowed="false" />
        </fileExtensions>
      </requestFiltering>
    </security>

    <!-- ================= Layer 4: output caching =========================== -->
    <caching enabled="true" enableKernelCache="true">
      <profiles>
        <add extension=".css"    policy="CacheForTimePeriod" duration="00:05:00" kernelCachePolicy="CacheUntilChange" />
        <add extension=".js"     policy="CacheForTimePeriod" duration="00:05:00" kernelCachePolicy="CacheUntilChange" />
        <add extension=".svg"    policy="CacheForTimePeriod" duration="00:30:00" kernelCachePolicy="CacheUntilChange" />
        <add extension=".woff2"  policy="CacheForTimePeriod" duration="30:00:00" kernelCachePolicy="CacheUntilChange" />
      </profiles>
    </caching>

    <httpCompression directory="%SystemDrive%\inetpub\temp\IIS Temporary Compressed Files">
      <scheme name="gzip" dll="%Windir%\system32\inetsrv\gzip.dll" staticCompressionLevel="7" />
      <dynamicTypes>
        <add mimeType="application/json" enabled="true" />
        <add mimeType="application/javascript" enabled="true" />
        <add mimeType="text/css" enabled="true" />
        <add mimeType="text/plain" enabled="true" />
      </dynamicTypes>
    </httpCompression>

    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
      </customHeaders>
    </httpProtocol>

    <!-- ================= Layer 3/5: connection + diagnostics =============== -->
    <httpErrors errorMode="DetailedLocalOnly" existingResponse="Auto" />
    <tracing>
      <traceFailedRequests>
        <!-- Failed Request Tracing: set to 5xx + 429 to catch overload events -->
        <add path="*">
          <traceAreas>
            <add provider="ASP" verbosity="Verbose" />
            <add provider="ISAPI Extension" verbosity="Verbose" />
            <add provider="WWW Server" areas="Authentication,Security,Filter,StaticFile,CGI,Compression,Cache,RequestNotifications,Module,FastCGI,WebSocket,ForbiddenAccess,RequestLimits" verbosity="Verbose" />
          </traceAreas>
          <failureDefinitions statusCodes="429,500,502,503,504" timeTaken="00:00:05" />
        </add>
      </traceFailedRequests>
    </tracing>

    <serverRuntime appConcurrentRequestLimit="5000" uploadReadAheadSize="49152" />
    <urlCompression doStaticCompression="true" doDynamicCompression="true" />

    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>
  </system.webServer>
</configuration>
<!--
  ===========================================================================
   Fleet view + autoscaling on Windows
  ===========================================================================
   * Per-replica telemetry:  http://127.0.0.1:8001/api/scalability
   * Fleet view: set JAN_DRISHTI_CLUSTER_NODES on every replica, e.g.
        setx JAN_DRISHTI_CLUSTER_NODES "http://127.0.0.1:8001,http://127.0.0.1:8002,http://127.0.0.1:8003,http://127.0.0.1:8004" /M
        setx JAN_DRISHTI_PROXY_LAYER "iis" /M
   * ARR farm health test: /health (fast, never rate limited or shed).
   * Autoscaling on Windows Server: run the same signal the dashboard shows
     (p95 ms / req-s per replica) from a scheduled PowerShell script that starts
     or stops extra `python -m jan_drishti.server --port 800N` processes and
     updates the farm; on Azure, use the VM Scale Set autoscale rules against
     the same /api/metrics counters.
  ===========================================================================
-->
